# ===============================================================
#  Seguimiento de Pendientes - configuracion
# ===============================================================
#  Copiar este archivo a  .env  y completar los valores marcados.
#  El script ./instalar.sh lo hace automaticamente.
#
#  IMPORTANTE: el archivo .env contiene credenciales.
#  No versionarlo ni enviarlo por correo.  chmod 600 .env
# ===============================================================

# --- Aplicacion ---------------------------------------------------

# Puerto por el que entran las estaciones de trabajo.
APP_PORT=8000

# CAMBIAR. Generar con:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CAMBIAR-generar-una-clave-de-50-caracteres

# Siempre False fuera de desarrollo. En True expone trazas de error.
DEBUG=False

# IP o nombre del servidor, separados por coma. NO dejar * en produccion.
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
ALLOWED_HOSTS=localhost,127.0.0.1

# Direcciones completas desde las que se accede, con protocolo y puerto.
# Si falta la IP aca, el sistema abre pero NINGUN formulario funciona.
#   CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.1.50:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Membrete de los archivos exportados --------------------------
#
# Se estampa en los Excel y en la presentacion de PowerPoint.
# Nada de esto esta escrito en el codigo: si el nombre sale mal impreso
# en un reporte que ya circulo, se corrige aca y se reinicia, sin tocar
# Python ni reconstruir la imagen.

ORG_NOMBRE=Banco Digital de los Trabajadores
ORG_SIGLA=BDT

# Gerencia o division. Dejar vacio para que el membrete muestre solo
# el nombre del banco.
ORG_UNIDAD=

# Leyenda al pie de cada hoja y de cada diapositiva.
ORG_CLASIFICACION=Uso interno

# Azul institucional, tomado del logo. SIN el "#".
ORG_COLOR=203078

# Ruta al logo DENTRO del contenedor. El archivo viaja en la imagen
# (app/tracker/marca/), asi que normalmente no hay que tocar esto.
# Para cambiar el logo sin reconstruir: montarlo como volumen en
# compose.yaml y apuntar esta variable ahi.
ORG_LOGO=/app/tracker/marca/bdt-logo.png

# --- Base de datos ------------------------------------------------

DB_NAME=pendientes
DB_USER=pendientes

# CAMBIAR por una contrasena fuerte.
# Ojo: PostgreSQL la fija al crear el volumen. Cambiarla despues aca
# no la cambia en la base (ver DESPLIEGUE.md, seccion 10).
DB_PASSWORD=CAMBIAR-contrasena-fuerte

DB_HOST=db
DB_PORT=5432

# Puerto que Postgres expone en el anfitrion, para DBeaver o psql.
DB_PORT_HOST=55432

# --- Usuario administrador ----------------------------------------
#
# Se crea solo en el primer arranque. Es la credencial de instalacion:
# CAMBIARLA al terminar el despliegue con
#   docker compose exec web python manage.py changepassword admin

ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR-contrasena-de-administrador
ADMIN_EMAIL=soporte@empresa.com
